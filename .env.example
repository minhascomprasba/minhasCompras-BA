SEFAZ_URL=https://nfe.sefaz.ba.gov.br/servicos/nfce/Modulos/Geral/NFCEC_consulta_chave_acesso.aspx
PAGE_TIMEOUT_SECONDS=20
MAX_CAPTCHA_ATTEMPTS=5
HEADLESS=false
CAPTCHA_TTL_SECONDS=300
IMPORT_RATE_LIMIT_PER_MIN=10
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=troque-por-uma-chave-segura
JWT_EXPIRATION_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://minhas-compras-ba.vercel.app
FRONTEND_URL=http://localhost:5173
# E-mails promovidos a SUPER_ADMIN no startup da API (separados por virgula)
SUPER_ADMIN_EMAILS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente verificado no Brevo/SendGrid (seu e-mail real, NÃO o login @smtp-brevo.com)
SMTP_FROM=Minhas Compras BA <seu@email.com>
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=60
PASSWORD_RESET_RATE_LIMIT_PER_MIN=3
EMAIL_VERIFICATION_CODE_EXPIRATION_MINUTES=15
EMAIL_VERIFICATION_RATE_LIMIT_PER_MIN=3
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
